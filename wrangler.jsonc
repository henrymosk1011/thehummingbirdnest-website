{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thehummingbirdnest",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  // Plain settings. The contact form goes from the browser straight to FormSubmit, so the
  // Worker needs no email settings or secrets (see formSubmitTo in site/config.mjs).
  "vars": {
    "CANONICAL_HOST": "www.thehummingbirdnest.org",
    // Instagram section on the home page: paste the Behold JSON feed ID here (see DEPLOY.md).
    "BEHOLD_FEED_ID": ""
  }
}
